<Window x:Class="ZdC.App.PaperDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="430" SizeToContent="Height" MaxHeight="600" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        AllowsTransparency="True" Background="Transparent" Foreground="{StaticResource Ink}" FontFamily="Palatino Linotype, KaiTi" FontSize="14" UseLayoutRounding="True" KeyDown="Dialog_KeyDown" PreviewMouseLeftButtonDown="Title_MouseLeftButtonDown">
    <Grid>
        <Path x:Name="StoneMass" IsHitTestVisible="False"/>
        <Border x:Name="StoneFace" SizeChanged="StoneFace_SizeChanged" Margin="0,0,4,5">
            <Grid>
                <Rectangle x:Name="PaperGrain" IsHitTestVisible="False" Opacity="0.18"><Rectangle.Fill><ImageBrush ImageSource="Assets/ZdC.png" Viewbox="0.23,0.05,0.08,0.08" ViewboxUnits="RelativeToBoundingBox" Viewport="0,0,110,110" ViewportUnits="Absolute" TileMode="Tile"/></Rectangle.Fill></Rectangle>
                <Grid x:Name="MossGrain" IsHitTestVisible="False" Opacity="0.22">
                    <Rectangle><Rectangle.Fill><RadialGradientBrush Center="0.12,0.14" GradientOrigin="0.12,0.14" RadiusX="0.42" RadiusY="0.32"><GradientStop Color="#5C7159" Offset="0"/><GradientStop Color="#006A7B61" Offset="1"/></RadialGradientBrush></Rectangle.Fill></Rectangle>
                    <Rectangle><Rectangle.Fill><RadialGradientBrush Center="0.86,0.76" GradientOrigin="0.86,0.76" RadiusX="0.32" RadiusY="0.4"><GradientStop Color="#52694E" Offset="0"/><GradientStop Color="#006A7B61" Offset="1"/></RadialGradientBrush></Rectangle.Fill></Rectangle>
                    <Path Stretch="Fill" Data="M 0,13 Q 7,9 9,17 T 17,20 L 14,34 Q 8,29 4,37 L 0,42 Z M 91,64 Q 85,70 89,81 T 100,96 L 100,59 Z" Fill="#506343" Opacity="0.25"/>
                </Grid>
                <Grid x:Name="MarbleGrain" Visibility="Collapsed" IsHitTestVisible="False">
                    <Rectangle Opacity="0.6"><Rectangle.Fill><DrawingBrush TileMode="Tile" Viewport="0,0,180,100" ViewportUnits="Absolute"><DrawingBrush.Drawing><DrawingGroup>
                        <GeometryDrawing Brush="Transparent" Geometry="M 0,0 L 180,0 180,100 0,100 Z"/>
                        <GeometryDrawing Geometry="M -5,68 C 30,44 47,58 77,30 S 123,20 185,-4"><GeometryDrawing.Pen><Pen Brush="#42ADB5AD" Thickness="0.7"/></GeometryDrawing.Pen></GeometryDrawing>
                        <GeometryDrawing Geometry="M 40,102 C 62,75 99,83 122,60 S 157,58 184,33 M 81,80 Q 92,63 88,48"><GeometryDrawing.Pen><Pen Brush="#24AAB2AB" Thickness="0.45"/></GeometryDrawing.Pen></GeometryDrawing>
                    </DrawingGroup></DrawingBrush.Drawing></DrawingBrush></Rectangle.Fill></Rectangle>
                    <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="0.18"/><GradientStop Color="#90FFFFFF" Offset="0.28"/><GradientStop Color="#25FFFFFF" Offset="0.4"/><GradientStop Color="#00FFFFFF" Offset="0.48"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                </Grid>
                <Grid Margin="30,26,28,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="Heading" FontSize="23" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource StoneHeaderButton}" Click="Close_Click" ToolTip="关闭" AutomationProperties.Name="关闭说明">
                            <Grid Width="20" Height="20">
    <Path Data="M 4,3 L 10,8 15,3 17,5 12,10 17,15 15,17 10,12 5,17 3,15 8,10 3,5 Z" Fill="#A39F98"/>
    <Path x:Name="CloseMark" Data="M 4,4 L 16,16 M 16,4 L 4,16" StrokeThickness="2.1"/>
    <Path Data="M 5,3 L 10,7 M 15,3 L 12,6 M 4,16 L 8,12" Stroke="#E6E2DA" StrokeThickness="0.65" Opacity="0.7"/>
</Grid>
                        </Button>
                    </Grid>
                    <Border x:Name="Divider" Grid.Row="1" Height="1" Margin="0,14,0,16"/>
                    <ScrollViewer Grid.Row="2" MaxHeight="420" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="Body" TextWrapping="Wrap" LineHeight="26"/>
                    </ScrollViewer>
                    <StackPanel x:Name="ConfirmationActions" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0" Visibility="Collapsed">
                        <Button x:Name="ConfirmButton" Content="确定" Foreground="#285D9C" Style="{StaticResource SmokeActionButton}" Click="Confirm_Click"/>
                        <Button Content="取消" Foreground="#9C282C" Style="{StaticResource SmokeActionButton}" Click="Close_Click" Margin="10,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>