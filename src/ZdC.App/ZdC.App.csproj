<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ZdC</AssemblyName>
    <RootNamespace>ZdC.App</RootNamespace>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ZdC.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" /></ItemGroup>
  <ItemGroup><ProjectReference Include="..\ZdC.Core\ZdC.Core.csproj" /></ItemGroup>
  <ItemGroup><Content Include="..\..\artifacts\connectex-build\ZdC.SocketController.exe" Link="ZdC.SocketController.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /><Content Include="..\..\artifacts\connectex-build\ZdC.SocketHook64.dll" Link="ZdC.SocketHook64.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /><Content Include="..\..\artifacts\connectex-build\ZdC.SocketHook32.dll" Link="ZdC.SocketHook32.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Resource Include="Assets\ZdC.png" /><Resource Include="Assets\ZdCMark.png" /></ItemGroup>
</Project>
