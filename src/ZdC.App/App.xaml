                    <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
                    <Grid x:Name="Play">
<Path Data="M 3,1 L 25,13 L 3,25 Z" Stroke="#173E25" StrokeThickness="0.8" StrokeLineJoin="Miter">
<Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#4E8352" Offset="0"/><GradientStop Color="#1E5A35" Offset="0.48"/><GradientStop Color="#347348" Offset="1"/></LinearGradientBrush></Path.Fill>
</Path>
<Path Data="M 4,3 L 22,13 M 4,3 L 4,22" Stroke="#BCD0A0" StrokeThickness="0.65" Opacity="0.8"/>
<Path Data="M 5,23 L 23,13" Stroke="#12331D" StrokeThickness="1"/>
<Path Data="M 5,6 L 9,9 7,13 12,16 10,20 M 9,9 L 15,8 M 7,13 L 16,12 20,15 M 12,16 L 18,16 M 5,18 L 8,17" Stroke="#102E1B" StrokeThickness="0.55" Opacity="0.62"/>
<Path Data="M 5,7 L 8,9 M 8,14 L 12,17 M 12,12 L 17,12 M 14,15 L 18,15" Stroke="#82AB70" StrokeThickness="0.4" Opacity="0.65"/>
</Grid>
<Grid x:Name="Stop" Visibility="Collapsed">
                        <Path Data="M 3,1 L 23,1 L 25,3 L 25,23 L 23,25 L 3,25 L 1,23 L 1,3 Z" Stroke="#4F1518" StrokeThickness="1">
                            <Path.Fill><ImageBrush ImageSource="Assets/ZdC.png" Viewbox="0.25,0.305,0.06,0.018" ViewboxUnits="RelativeToBoundingBox" Stretch="Fill"/></Path.Fill>
                        </Path>
                        <Path Data="M 2,4 L 4,2 L 22,2" Stroke="#DC8B7D" StrokeThickness="0.8" Opacity="0.8"/>
                        <Path Data="M 24,4 L 24,22 L 22,24 L 4,24" Stroke="#52171B" StrokeThickness="1.2"/>
                    </Grid>
                </Grid>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Play" Property="Visibility" Value="Collapsed"/><Setter TargetName="Stop" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusOutline" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard x:Name="RunFlow"><Storyboard Timeline.DesiredFrameRate="30"><DoubleAnimation Storyboard.TargetName="RunSmoke" Storyboard.TargetProperty="Opacity" From="0.4" To="0.9" Duration="0:0:1.4" AutoReverse="True" RepeatBehavior="Forever"/><DoubleAnimation Storyboard.TargetName="RunRise" Storyboard.TargetProperty="Y" From="3" To="-4" Duration="0:0:2" AutoReverse="True" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><RemoveStoryboard BeginStoryboardName="RunFlow"/></Trigger.ExitActions></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Glyph" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.93" ScaleY="0.93"/></Setter.Value></Setter></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="ToolTip" Value="暂停直连"/><Setter Property="AutomationProperties.Name" Value="暂停直连"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal"><Border x:Name="Box" Width="18" Height="18" Background="Transparent" BorderBrush="#A5A3A1" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center"><Path x:Name="Tick" Data="M 3,8 L 7,12 L 14,4" Stroke="White" StrokeThickness="1.7" Visibility="Collapsed"/></Border><ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/></StackPanel>
            <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderThickness" Value="2"/><Setter TargetName="Box" Property="BorderBrush" Value="#29292D"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Expander">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel>
