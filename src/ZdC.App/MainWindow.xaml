<ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
<ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
    <Setter Property="Width" Value="168"/><Setter Property="Height" Value="140"/><Setter Property="Margin" Value="0,0,4,4"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
        <!-- 透明区域只负责鼠标感应，不铺设卡片底色。烟使用原标志上方的真实烟纹。 -->
        <Grid Background="Transparent">
            <Grid x:Name="Smoke" Width="120" Height="80" VerticalAlignment="Top" Margin="0,2,2,0" IsHitTestVisible="False" Visibility="Collapsed">
                <Grid.OpacityMask><RadialGradientBrush GradientOrigin="0.5,0.52" Center="0.5,0.52" RadiusX="0.5" RadiusY="0.5"><GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#FFFFFFFF" Offset="0.3"/><GradientStop Color="#FFFFFFFF" Offset="0.78"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></Grid.OpacityMask>
                <Rectangle x:Name="SmokeBack" Width="112" Height="70" Opacity="0.48" RenderTransformOrigin="0.5,0.7">
                    <Rectangle.Fill><ImageBrush ImageSource="Assets/ZdCMark.png" ViewboxUnits="Absolute" Viewbox="730,35,550,220" Stretch="Fill"/></Rectangle.Fill>
                    <Rectangle.RenderTransform><TransformGroup><ScaleTransform x:Name="SmokeScale" ScaleX="0.88" ScaleY="0.88"/><TranslateTransform x:Name="SmokeRise" Y="8"/></TransformGroup></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle x:Name="SmokeFront" Width="104" Height="66" Opacity="0.3" RenderTransformOrigin="0.5,0.7">
                    <Rectangle.Fill><ImageBrush ImageSource="Assets/ZdCMark.png" ViewboxUnits="Absolute" Viewbox="490,75,540,190" Stretch="Fill"/></Rectangle.Fill>
                    <Rectangle.RenderTransform><TranslateTransform x:Name="SmokeDrift" X="-5" Y="6"/></Rectangle.RenderTransform>
                </Rectangle>
            </Grid>
            <ContentPresenter Margin="8"/>
        </Grid>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsIconHovered}" Value="True">
                <Setter TargetName="Smoke" Property="Visibility" Value="Visible"/>
                <DataTrigger.EnterActions><BeginStoryboard x:Name="HoverSmoke"><Storyboard Timeline.DesiredFrameRate="30">
                    <DoubleAnimation Storyboard.TargetName="SmokeRise" Storyboard.TargetProperty="Y" From="8" To="-9" Duration="0:0:2.8" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="SmokeScale" Storyboard.TargetProperty="ScaleX" From="0.88" To="1.08" Duration="0:0:2.8" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="SmokeScale" Storyboard.TargetProperty="ScaleY" From="0.88" To="1.1" Duration="0:0:2.8" RepeatBehavior="Forever"/>
                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="SmokeBack" Storyboard.TargetProperty="Opacity" Duration="0:0:2.8" RepeatBehavior="Forever"><LinearDoubleKeyFrame Value="0" KeyTime="0:0:0"/><LinearDoubleKeyFrame Value="0.95" KeyTime="0:0:0.4"/><LinearDoubleKeyFrame Value="0.88" KeyTime="0:0:2.1"/><LinearDoubleKeyFrame Value="0" KeyTime="0:0:2.8"/></DoubleAnimationUsingKeyFrames>
                    <DoubleAnimation Storyboard.TargetName="SmokeDrift" Storyboard.TargetProperty="Y" From="6" To="-6" Duration="0:0:2.1" AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="SmokeDrift" Storyboard.TargetProperty="X" From="-5" To="5" Duration="0:0:3.1" AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="SmokeFront" Storyboard.TargetProperty="Opacity" From="0.5" To="0.78" Duration="0:0:1.6" AutoReverse="True" RepeatBehavior="Forever"/>
                </Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                <DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="HoverSmoke"/></DataTrigger.ExitActions>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
</Style></ListBox.ItemContainerStyle>
